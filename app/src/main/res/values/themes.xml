<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.StressMeter" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">#002B5B</item>
        <item name="colorPrimaryVariant">#001F46</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">#808080</item>
        <item name="colorSecondaryVariant">#A9A9A9</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:statusBarColor">#001F46</item>
        <item name="android:colorBackground">#F5F5F5</item>
        <item name="android:textColorPrimary">#000000</item>
    </style>
    <style name="Theme.StressMeter.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="Theme.StressMeter.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.StressMeter.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
